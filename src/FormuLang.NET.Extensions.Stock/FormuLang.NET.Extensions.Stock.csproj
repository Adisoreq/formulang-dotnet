<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Stock standard (stock-1.0) of FormuLang.NET: candles, technical indicators, candle patterns and trading strategies written as FormuLang formulas, with a formula registry, LOAD_INDICATOR and LOAD_PATTERN.</Description>
    <PackageTags>$(PackageTags);stock;trading;indicators;candles;patterns;strategies</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FormuLang.NET.Extensions.Stock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormuLang.NET.Abstractions\FormuLang.NET.Abstractions.csproj" />
    <ProjectReference Include="..\FormuLang.NET.Core\FormuLang.NET.Core.csproj" />
  </ItemGroup>

</Project>
